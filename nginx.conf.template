# The nginx image fills in ${BACKEND_URL} from the environment when the container starts.
# Variables that aren't set in the environment (like $uri below) are left as they are.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # File uploads go through here too; nginx's default limit is only 1 MB
    client_max_body_size 50m;

    # API calls go to the backend without the /api prefix (the trailing slash strips it),
    # because the NestJS routes have none. ^~ keeps the static-file rule below from catching them
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routes (e.g. /students/42) have no file on disk; let React Router handle them
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be cached, or users keep loading an old build after a deploy
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in every file name under /assets/, so they can be cached for good
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
